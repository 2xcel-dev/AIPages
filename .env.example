# AIPages Backend — Environment Configuration

# Server
PORT=3000

# MongoDB Atlas (M0 Free Tier)
MONGODB_URI=mongodb://user:***@cluster.mongodb.net:27017/aipages?ssl=true

# Gemini embeddings (via @google/genai SDK — 3072-dim, cosine)
#   GEMINI_EMBEDDING_MODEL  →  embedding model (default: gemini-embedding-001, 3072-dim)
#   GEMINI_SCHEMA_MODEL    →  schema generation model (default: gemini-3.6-flash)
GEMINI_API_KEY=***
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# x402 Payment Configuration
# Your USDC-receiving wallet address on Base
X402_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Base Sepolia testnet (84532) for dev, Base mainnet (8453) for prod
X402_NETWORK=eip155:84532
# Flat platform take-rate per premium tool invocation (USDC). The ONLY monetization.
# Collected only on successful delivery — failed invocations are never charged.
X402_PRICE_USDC=0.25
# Facilitator URL (default: official x402.org facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

# ── Crawler ────────────────────────────────────────────────────────────────
# GitHub PAT for code search (unauthenticated code search returns 401; the
# crawler falls back to unauthenticated topic repo search without it).
GITHUB_TOKEN=

# MCP runtime probe — OFF by default. Probing an MCP server EXECUTES ITS CODE.
# Only enable inside an isolated sandbox/container with no host credentials.
#   CRAWL_MCP_PROBE=true   → probe config-style mcp.json `mcpServers` (HTTP + stdio)
#   CRAWL_MCP_EXEC=true    → additionally permit spawning stdio processes (npx/uvx/node)
#   CRAWL_MCP_TIMEOUT_MS   → per-server handshake timeout (default 30000)
CRAWL_MCP_PROBE=false
CRAWL_MCP_EXEC=false
CRAWL_MCP_TIMEOUT_MS=30000

# Crawl tuning (all optional)
# CRAWL_INTERVAL_MS=300000   # sleep between watch cycles
# CRAWL_MAX_REPOS=20         # max candidate repos per cycle
# CRAWL_TIMEOUT_MS=8000      # per-fetch / per-health-check timeout

# ── Verification gate (caller identity + request signature) ────────────────
# JSON map of agentId → { address: "<0x Base address>", publicKey: "<base64 SPKI Ed25519>", secret: "<hmac>" }.
#   address  → EIP-712 wallet auth (X-EIP712-Signature, recovered to the address)
#   publicKey→ Ed25519 (X-Signature, base64url)
#   secret   → HMAC-SHA256 (X-Signature, hex)
# When non-empty, every /invoke requires a valid signature (X-Timestamp +
# X-Signature / X-EIP712-Signature) for a known agent. Empty = dev passthrough.
# Example: {"agent-1":{"address":"0xAb5801a7D398351b8bE11C439e05C5B3259aeC9B"}}
AGENT_KEYS={}
# Force strict verification (401 without a valid signature) even with no keys.
VERIFY_REQUIRE_SIGNATURE=false
# Max allowed skew between X-Timestamp and now (ms).
SIGNATURE_MAX_AGE_MS=300000
# EIP-712 domain chainId (must match what clients sign; default Base mainnet 8453).
SIGNING_CHAIN_ID=8453

# ── Egress guard (SSRF / proxy hardening) ──────────────────────────────────
# Allowlist of downstream hosts (comma-separated; exact or "*.example.com").
# Empty = allow any PUBLIC host (private/reserved IPs are always blocked unless
# PROXY_ALLOW_PRIVATE=true).
PROXY_ALLOWED_HOSTS=

# ── PostHog Analytics (optional) ───────────────────────────────────────────
# POSTHOG_API_KEY — if set, tracks tool invocations, submissions, and searches
# POSTHOG_HOST — default: https://us.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com
# Permit proxying to private/reserved IPs (loopback, RFC1918) — OFF by default.
PROXY_ALLOW_PRIVATE=false
# Hard request/response size caps.
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=5242880

# ── Prompt injection / payload sanitization ────────────────────────────────
# Scan invocation payloads for code-execution + jailbreak patterns.
SANITIZER_ENABLED=true
# "block" (reject with 422) or "log" (flag but allow).
SANITIZER_MODE=block
# Extra comma-separated regex patterns to flag (appended to the built-ins).
SANITIZER_EXTRA_PATTERNS=

# ── Behavioral anomaly detection & quarantine ──────────────────────────────
# A caller exceeding these thresholds is temporarily quarantined (escalating).
ANOMALY_BURST_MAX=120        # requests per window that trigger a burst quarantine
ANOMALY_BURST_WINDOW_MS=60000
ANOMALY_ERROR_MAX=20         # 4xx/5xx errors per window that trigger quarantine
ANOMALY_ERROR_WINDOW_MS=60000
ANOMALY_QUARANTINE_MS=300000 # base quarantine (escalates ×2 per repeat, cap 1h)
