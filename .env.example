# AIPages Backend — Environment Configuration

# Server
PORT=3001

# MongoDB Atlas (M0 Free Tier)
MONGODB_URI=your_mongodb_connection_string_here

# Gemini embeddings (via @google/genai SDK — 3072-dim, cosine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Environment Mode
NODE_ENV=production

# Base On-Chain & x402 Payment Configuration
BASE_RPC_URL=https://mainnet.base.org
RECIPIENT_ADDRESS=0xE57cB8C73c4000EA04ba0eb607228CbAec7f8e9C
WALLET_PRIVATE_KEY=your_private_key_here
X402_WALLET_ADDRESS=0xE57cB8C73c4000EA04ba0eb607228CbAec7f8e9C
X402_NETWORK=eip155:8453
X402_PRICE_USDC=0.25
X402_FACILITATOR_URL=https://x402.org/facilitator

# Crawler
GITHUB_TOKEN=your_github_token_here

# Verification gate
AGENT_KEYS={}
VERIFY_REQUIRE_SIGNATURE=false

# PostHog Analytics (optional)
POSTHOG_API_KEY=your_posthog_key_here
POSTHOG_HOST=https://us.posthog.com